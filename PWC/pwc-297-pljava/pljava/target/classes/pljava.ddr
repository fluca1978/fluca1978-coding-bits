	AS e'int=PWC297.Task1.task1_pljava(int[])'
END PostgreSQL;
BEGIN PostgreSQL
CREATE OR REPLACE FUNCTION pwc297.task2_pljava(
	nums integer[])
	RETURNS integer
	LANGUAGE java IMMUTABLE
