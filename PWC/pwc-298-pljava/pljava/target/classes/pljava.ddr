SQLActions[]={
"BEGIN INSTALL
BEGIN PostgreSQL
CREATE OR REPLACE FUNCTION pwc298.task1_pljava(
	plain_matrix integer[],
	cols integer)
	RETURNS integer
	LANGUAGE java IMMUTABLE
	RETURNS NULL ON NULL INPUT
	AS e'int=PWC298.Task1.task1_pljava(int[],int)'
END PostgreSQL;
BEGIN PostgreSQL
CREATE OR REPLACE FUNCTION pwc298.task2_pljava(
	plain_intervals integer[])
	RETURNS integer[]
	LANGUAGE java IMMUTABLE
	RETURNS NULL ON NULL INPUT
	AS e'int[]=PWC298.Task2.task2_pljava(int[])'
END PostgreSQL;
END INSTALL",
"BEGIN REMOVE
BEGIN PostgreSQL
DROP FUNCTION pwc298.task1_pljava(
	plain_matrix integer[],
	cols integer)
END PostgreSQL;
BEGIN PostgreSQL
DROP FUNCTION pwc298.task2_pljava(
	plain_intervals integer[])
END PostgreSQL;
END REMOVE"
}
