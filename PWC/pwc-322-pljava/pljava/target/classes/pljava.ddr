SQLActions[]={
"BEGIN INSTALL
BEGIN PostgreSQL
CREATE OR REPLACE FUNCTION pwc322.task1_pljava(
	string pg_catalog.varchar,
	size integer)
	RETURNS pg_catalog.varchar
	LANGUAGE java IMMUTABLE
	RETURNS NULL ON NULL INPUT
	AS e'java.lang.String=PWC322.Task1.task1_pljava(java.lang.String,int)'
END PostgreSQL;
BEGIN PostgreSQL
CREATE OR REPLACE FUNCTION pwc322.task2_pljava(
	numbers integer[])
	RETURNS integer[]
	LANGUAGE java IMMUTABLE
	RETURNS NULL ON NULL INPUT
	AS e'int[]=PWC322.Task2.task2_pljava(int[])'
END PostgreSQL;
END INSTALL",
"BEGIN REMOVE
BEGIN PostgreSQL
DROP FUNCTION pwc322.task1_pljava(
	string pg_catalog.varchar,
	size integer)
END PostgreSQL;
BEGIN PostgreSQL
DROP FUNCTION pwc322.task2_pljava(
	numbers integer[])
END PostgreSQL;
END REMOVE"
}
